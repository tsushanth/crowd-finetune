[Unit]
Description=CrowdCheck QA FastAPI backend (Telegram miniapp)
After=network.target

[Service]
WorkingDirectory=<REPO>
EnvironmentFile=<REPO>/.env
ExecStart=<REPO>/.venv/bin/python -m uvicorn backend.game:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target