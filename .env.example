BASE_LLM_URL=https://api.openai.com/v1
BASE_LLM_API_KEY=
BASE_LLM_MODEL=qwen2.5-7b-instruct
JUDGE_MODEL=gpt-4o-mini
JUDGE_MIN_SCORE=0.9
FILTER_THETA=0.8
MIN_EVAL_DELTA=0.03
# reasoning track (training/reasoning/): teacher model for distilling traces
TEACHER_MODEL=deepseek/deepseek-r1-0528
BACKEND_URL=http://localhost:8000
DB_PATH=data/crowd.db
CORPUS_PATH=data/corpus.jsonl
# Telegram miniapp production auth (REQUIRE_TG_AUTH=true switches the API to
# verify signed Telegram initData instead of trusting the submitted tg_user_id)
TELEGRAM_BOT_TOKEN=
REQUIRE_TG_AUTH=false